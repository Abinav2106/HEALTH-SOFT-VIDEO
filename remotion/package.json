{
  "name": "healthsoft-video",
  "private": true,
  "version": "0.1.0",
  "description": "Healthsoft video compositions (Remotion). Video 06 lives in src/video06; the Tilo / GoFloaters reward animation in src/tilo.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:v06:preview": "remotion render src/index.ts V06-Preview out/v06_preview_1080x1920_24p.mp4",
    "render:v06:opening": "remotion render src/index.ts V06-Opening out/v06_opening_0-16s_1080x1920_24p.mp4",
    "render:v06:mg": "remotion render src/index.ts V06-MotionSection out/v06_motion_section_1080x1920_24p.mp4",
    "render:v06:master": "remotion render src/index.ts V06-Master out/v06_master_1080x1920_24p.mp4",
    "still": "remotion still src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:tilo": "remotion render src/index.ts Tilo-Reward out/tilo/tilo_reward_1080x1350_30p.mp4",
    "render:tilo:silent": "remotion render src/index.ts Tilo-Reward out/tilo/tilo_reward_1080x1350_30p_silent.mp4 --props='{\"sound\":false}' --muted",
    "tilo:check": "esbuild scripts/tilo-check.ts --bundle --platform=node --format=esm --outfile=out/tilo-check.mjs --log-level=warning --external:react --external:react-dom && node out/tilo-check.mjs",
    "tilo:svg": "esbuild scripts/tilo-export-svg.tsx --bundle --platform=node --format=esm --jsx=automatic --outfile=out/tilo-export-svg.mjs --log-level=warning --external:react --external:react-dom && node out/tilo-export-svg.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
