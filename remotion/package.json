{
  "name": "healthsoft-video",
  "private": true,
  "version": "0.1.0",
  "description": "Video compositions (Remotion). Healthsoft Video 06 in src/video06; W&W \"Start with why.\" in src/ww.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:v06:preview": "remotion render src/index.ts V06-Preview out/v06_preview_1080x1920_24p.mp4",
    "render:v06:opening": "remotion render src/index.ts V06-Opening out/v06_opening_0-16s_1080x1920_24p.mp4",
    "render:v06:mg": "remotion render src/index.ts V06-MotionSection out/v06_motion_section_1080x1920_24p.mp4",
    "render:v06:master": "remotion render src/index.ts V06-Master out/v06_master_1080x1920_24p.mp4",
    "still": "remotion still src/index.ts",
    "typecheck": "tsc --noEmit",
    "ww:heroes": "node scripts/ww-heroes.mjs",
    "ww:render:review": "remotion render src/index.ts WW-Review out/ww_start-with-why_review_1080x1920_30p.mp4",
    "ww:render:opening": "remotion render src/index.ts WW-Opening out/ww_opening-test_0-15s_1080x1920_30p.mp4",
    "ww:render:master": "remotion render src/index.ts WW-Master out/ww_start-with-why_master_1080x1920_30p.mp4",
    "ww:render": "npm run ww:heroes && npm run ww:render:review"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
